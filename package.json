{
  "name": "elsewhere",
  "version": "0.1.0",
  "private": true,
  "description": "Elsewhere is an immersive audio experience generator that creates cinematic, spatially layered audio journeys designed to help users mentally escape into another environment.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ai:director:smoke": "npm run build && node dist/openai-ai-director-smoke.js",
    "ai:outline:smoke": "npm run build && node dist/openai-journey-outline-smoke.js",
    "ai:section-02:smoke": "npm run build && node dist/rainy-forest-section-02-director-smoke.js",
    "ai:section-03:smoke": "npm run build && node dist/rainy-forest-section-03-director-smoke.js",
    "ai:section:smoke": "npm run build && node dist/openai-section-director-smoke.js",
    "build": "tsc",
    "narration:integration:smoke": "npm run build && node dist/night-ocean-narration-integration-smoke.js",
    "rainy-forest-section-01:integration:smoke": "npm run build && node dist/rainy-forest-section-01-integration-smoke.js",
    "rainy-forest-section-02:integration:smoke": "npm run build && node dist/rainy-forest-section-02-integration-smoke.js",
    "start": "node dist/index.js",
    "test": "npm run build && node --test",
    "tts:narration:smoke": "npm run build && node dist/openai-narration-tts-smoke.js",
    "tts:rainy-forest-section-01:smoke": "npm run build && node dist/rainy-forest-section-01-tts-smoke.js",
    "tts:rainy-forest-section-02:smoke": "npm run build && node dist/rainy-forest-section-02-tts-smoke.js",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Olgabelokopytova90/elsewhere.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Olgabelokopytova90/elsewhere/issues"
  },
  "homepage": "https://github.com/Olgabelokopytova90/elsewhere#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "openai": "^7.8.0"
  }
}
